# Copiá este archivo a .env.local (que ya está en .gitignore) para
# sobrescribir los valores por defecto. Vite solo expone al navegador las
# variables que empiezan con VITE_.

# Credenciales del Panel Admin (por defecto: admin@vrbeautylash.com / SoftivaLash2026!)
VITE_ADMIN_USER=admin@vrbeautylash.com
VITE_ADMIN_PASSWORD=SoftivaLash2026!

# Public key de Mercado Pago (la clave PRIVADA/Access Token nunca va acá,
# ver src/data/mercadoPago.js)
VITE_MP_PUBLIC_KEY=
